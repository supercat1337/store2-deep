{
    "name": "@supercat1337/store2-deep",
    "version": "0.1.0",
    "description": "Deep reactivity for @supercat1337/store2 — mutable nested state with granular updates",
    "type": "module",
    "main": "src/index.js",
    "types": "src/types.d.ts",
    "exports": {
        ".": {
            "types": "./src/types.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        }
    },
