{
    "name": "@supercat1337/store2-deep",
    "version": "1.1.0",
    "description": "Deep reactivity for @supercat1337/store2 — mutable nested state with granular updates.",
    "author": "Albert Bazaleev",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/types.d.ts",
            "import": "./dist/store2-deep.esm.js"
        }
    },
    "types": "dist/types.d.ts",
    "scripts": {
        "test": "c8 ava",
        "clean": "shx rm -rf ./dist && shx mkdir ./dist",
        "build_esm": "rollup ./src/index.js --file ./dist/store2-deep.esm.js --format es",
        "build_esm_bundle": "esbuild ./src/index.js --format=esm --bundle --platform=neutral --external:@supercat1337/store2 --outfile=./dist/store2-deep.esm.bundle.js",
        "gen_types": "npx tsc --project my.tsconfig.types.json && shx cp src/index.d.ts dist/types-temp/src/index.d.ts",
        "bundle_types": "api-extractor run --local",
        "build": "npm run clean && npm run build_esm && npm run build_esm_bundle && npm run gen_types && npm run bundle_types && shx rm -rf dist/types-temp",
        "lint": "eslint src/ tests/",
        "lint_fix": "npm run lint -- --fix",
        "prepublishOnly": "npm run build && npm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.59.4",
        "@supercat1337/store2": "^3.0.2",
        "@supercat1337/store2-dom": "*",
        "ava": "^6.1.2",
        "c8": "^12.0.0",
        "esbuild": "^0.24.0",
        "eslint": "^10.8.1",
        "eslint-plugin-jsdoc": "^63.3.3",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.9.0",
        "jsdom": "^29.1.1",
        "rollup": "^4.60.1",
        "rollup-plugin-cleanup": "^3.2.1",
        "shx": "^0.4.0"
    },
    "peerDependencies": {
        "@supercat1337/store2": "^2.0.10 || ^3.0.2"
    },
    "keywords": [
        "store2",
        "reactive",
        "deep",
        "proxy",
        "state",
        "mobx-like",
        "state management",
        "reactivity",
        "observable",
        "nested",
        "granular",
        "store2-deep"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/supercat1337/store2-deep.git"
    },
    "homepage": "https://github.com/supercat1337/store2-deep",
    "files": [
        "dist/store2-deep.esm.js",
        "dist/store2-deep.esm.bundle.js",
        "dist/types.d.ts",
        "README.md",
        "LICENSE.txt"
    ],
    "ava": {
        "files": [
            "tests/**/*.test.js"
        ],
        "nodeArguments": [
            "--experimental-vm-modules"
        ],
        "extensions": [
            "js"
        ],
        "timeout": "30s"
    }
}
